# Telegram
TELEGRAM_BOT_TOKEN={{telegram_bot_token}}

# Java integration
JAVA_BASE_URL={{java_base_url}}
JAVA_API_PATHS={"free_rooms":"{{java_api_paths.free_rooms}}","room_status":"{{java_api_paths.room_status}}","health":"{{java_api_paths.health}}"}

# Auth between bot and Java: none | api_key | bearer | basic
JAVA_AUTH_SCHEME={{java_auth_scheme}}
JAVA_AUTH_SECRET={{java_auth_secret}}
JAVA_API_KEY_HEADER=X-API-Key

# API contract hints (for documentation/debug)
REQUEST_JSON_SCHEMA={{request_json_schema}}
RESPONSE_JSON_SCHEMA={{response_json_schema}}

# Domain data
LOCATIONS_LIST={{locations_list}}
SEARCH_FILTERS={{search_filters}}

# Admin users (comma-separated or JSON array)
ADMIN_TELEGRAM_IDS={{admin_telegram_ids}}

# Runtime settings
REQUEST_TIMEOUT_SECONDS=8
MAX_RETRIES=3
RETRY_BACKOFF_BASE=0.6
STORAGE_PATH=data/users.json
LOG_PATH=logs/bot.log
LOG_LEVEL=INFO

